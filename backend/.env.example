# Path to the immutable trained model (absolute or relative to process cwd)
# Default if unset: ./weights/best_tomato_finetuned.keras
MODEL_PATH=./weights/best_tomato_finetuned.keras

# Optional: FastAPI bind settings (used by your shell/process manager)
# Prefer 8001 if another service already occupies 8000 on this machine.
PORT=8001
HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:8001
